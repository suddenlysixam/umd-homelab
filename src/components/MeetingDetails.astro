---
import { Icon } from "astro-icon/components";
import { withBase } from "../../config/basePath.mjs";
import AddToCalendarButton from "./AddToCalendarButton.astro";
import Slides from "./Slides.astro";

const { frontmatter } = Astro.props;

const meetingDate = new Date(frontmatter.date);
const now = new Date();
const isUpcoming = now <= meetingDate;
const timeZone = "America/New_York";

function ordinal(day: number) {
  if ([11, 12, 13].includes(day % 100)) return `${day}th`;

  switch (day % 10) {
    case 1:
      return `${day}st`;
    case 2:
      return `${day}nd`;
    case 3:
      return `${day}rd`;
    default:
      return `${day}th`;
  }
}

const weekday = meetingDate.toLocaleDateString("en-US", { weekday: "long" });
const month = meetingDate.toLocaleDateString("en-US", { month: "long" });
const day = ordinal(meetingDate.getDate());
const year = meetingDate.getFullYear();

const formattedDate = `${weekday}, ${month} ${day}, ${year}`;

const formattedTime = meetingDate.toLocaleTimeString("en-US", {
  hour: "numeric",
  minute: "2-digit",
  timeZone: timeZone,
});

const endDateObj = new Date(meetingDate.getTime() + 60 * 60 * 1000);

function dateInTimeZone(date: Date) {
  return new Intl.DateTimeFormat("en-CA", {
    timeZone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);
}

function timeInTimeZone(date: Date) {
  return new Intl.DateTimeFormat("en-GB", {
    timeZone,
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  }).format(date);
}

const startDate = dateInTimeZone(meetingDate);
const endDate = dateInTimeZone(endDateObj);

const startTime = timeInTimeZone(meetingDate);
const endTime = timeInTimeZone(endDateObj);

const slidesUrl = frontmatter.slides ? withBase(frontmatter.slides) : undefined;
---

<section class="meeting-card">
  <dl>
    <div class="meeting-row">
      <dt>
        <Icon name="mdi:calendar" class="meeting-icon" />
        When
      </dt>
      <dd>
        {formattedDate}{isUpcoming && `, starting at ${formattedTime}`}
      </dd>
    </div>

    {
      isUpcoming && frontmatter.location && (
        <div class="meeting-row">
          <dt>
            <Icon name="mdi:location-on-outline" class="meeting-icon" />
            Location
          </dt>
          <dd>{frontmatter.location}</dd>
        </div>
      )
    }

    {
      frontmatter.topic && (
        <div class="meeting-row">
          <dt>
            <Icon name="mdi:text-subject" class="meeting-icon" />
            Topic
          </dt>
          <dd>{frontmatter.topic}</dd>
        </div>
      )
    }
  </dl>

  {
    isUpcoming && (
      <div class="meeting-actions">
        <AddToCalendarButton
          name="Build I.T. Club at UMD Meeting"
          description={frontmatter.topic ?? ""}
          location={frontmatter.location ?? ""}
          startDate={startDate}
          endDate={endDate}
          startTime={startTime}
          endTime={endTime}
          timeZone={timeZone}
        />
      </div>
    )
  }
</section>

{
  isUpcoming && frontmatter.rsvp && (
    <>
      <h3>RSVP</h3>
      {/* <iframe src={frontmatter.rsvp} width="640" height="551" frameborder="0" marginheight="0" marginwidth="0">
        Loading…
      </iframe> */}
      <div class="rsvp-frame">
        <iframe src={frontmatter.rsvp} title="Meeting RSVP form" loading="lazy">
          Loading…
        </iframe>
      </div>
    </>
  )
}

<Slides frontmatter={frontmatter} />

{
  frontmatter.project && (
    <>
      <h3>Project Guide Page</h3>
      <p>
        A project guide page was created or updated based on the project completed during this meeting. See the guide{" "}
        <a href={frontmatter.project}>here</a>.
      </p>
    </>
  )
}
