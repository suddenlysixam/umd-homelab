---
import { authors } from "@config/authors.mjs";
import { withBase } from "@config/basePath.mjs";
import { slug } from "github-slugger";
import type { Author } from "@src/types/author";

interface Props {
  author: keyof typeof authors;
}

const { author } = Astro.props;
const authorInfo: Author = authors[author];

// function slugify(name: string): string {
//   return name
//     .toLowerCase()
//     .trim()
//     .replace(/\./g, "")
//     .replace(/[^a-z0-9]+/g, "-")
//     .replace(/^-|-$/g, "");
// }

// const authorUrl = withBase(`/meetings/authors/${slugify(authorInfo.name)}/`);

const authorUrl = withBase(`/authors/${slug(authorInfo.name)}/`);
---

<a class="author-card" href={authorUrl}>
  <div class="author-avatar">
    {
      authorInfo.picture ? (
        <img
          class="author-picture"
          src={authorInfo.picture}
          alt={`${authorInfo.name} profile picture`}
          loading="eager"
        />
      ) : (
        <span class="author-initial" aria-hidden="true">
          {authorInfo.name.charAt(0)}
        </span>
      )
    }
  </div>

  <div class="author-info">
    <div class="author-name">{authorInfo.name}</div>

    {authorInfo.title && <div class="author-title">{authorInfo.title}</div>}
  </div>
</a>

<style>
  .author-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    box-sizing: border-box;

    padding: 1rem 1.25rem;

    color: inherit;
    text-decoration: none;

    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);

    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .author-card:hover {
    color: inherit;
    text-decoration: none;
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
    transform: translateY(-1px);
  }

  .author-card:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .author-avatar {
    display: grid;
    place-items: center;

    width: 4rem;
    height: 4rem;
    /* flex-shrink: 0; */
    flex: 0 0 4rem;

    border-radius: 50%;
    background: var(--sl-color-gray-6);
  }

  .author-picture {
    display: block;
    width: 100%;
    height: 100%;

    border-radius: inherit;
    object-fit: cover;
  }

  .author-avatar:not(:has(.author-picture)) {
    /* background: var(--sl-color-gray-6); */
    background: var(--sl-color-accent-low);
    border: 1px solid var(--sl-color-gray-5);
  }

  .author-initial {
    /* color: var(--sl-color-gray-2); */
    color: var(--sl-color-accent-high);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .author-info {
    /* display: flex;
    flex-direction: column;
    justify-content: center; */

    min-width: 0;
    /* align-self: stretch; */
    margin: 0;
  }

  .author-name {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .author-title {
    margin: 0.2rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.4;
  }
</style>
