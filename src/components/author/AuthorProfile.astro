<section class="author-profile">
  <div class="author-overview">
    <div class="author-avatar">
      {
        authorInfo.picture ? (
          <img src={authorInfo.picture} alt={`${authorInfo.name} profile picture`} />
        ) : (
          <span aria-hidden="true">{authorInfo.name.charAt(0)}</span>
        )
      }
    </div>

    <div class="author-details">
      <h1>{authorInfo.name}</h1>

      {authorInfo.title && <div class="author-title">{authorInfo.title}</div>}

      {authorInfo.bio && <p class="author-bio">{authorInfo.bio}</p>}
    </div>
  </div>

  {
    socialLinks.length > 0 && (
      <div class="author-socials">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            <Icon name={social.icon} />
            <span>{social.label}</span>
          </a>
        ))}
      </div>
    )
  }
</section>
