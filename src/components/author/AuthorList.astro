---
import { authors } from "../../../config/authors.mjs";
import AuthorCard from "./AuthorCard.astro";

type AuthorKey = keyof typeof authors;

interface Props {
  authors: AuthorKey[];
}

const { authors: authorKeys } = Astro.props;
---

<div class="author-list">
  {authorKeys.map((author) => <AuthorCard author={author} />)}
</div>

<style>
  .author-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
