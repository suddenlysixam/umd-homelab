---
import { getCollection } from "astro:content";
import { ShowcaseText } from "starlight-showcases";
import { withBase } from "../../config/basePath.mjs";
import { sortPagesByModifiedDate, getPagePath } from "../../config/contentUtils.ts";

const { directory } = Astro.props;

const pages = await getCollection("docs", ({ id, data }) => {
  return id.startsWith(`${directory}/`) && !data.draft;
});

const entries = sortPagesByModifiedDate(pages).map((page) => {
  const date = (typeof page.data.lastUpdated === "boolean" ? page.data.date : page.data.lastUpdated) ?? page.data.date;

  const formattedDate = date?.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

  const dateText = formattedDate
    ? `<i>${page.data.lastUpdated ? "Updated" : "Published"} ${formattedDate}</i>`
    : undefined;

  return {
    title: page.data.title,
    description: [page.data.description, dateText].filter(Boolean).join('<div style="margin-top: 0.5rem;"></div>'),
    href: withBase(getPagePath(page)),
  };
});
---

<ShowcaseText entries={entries} />
