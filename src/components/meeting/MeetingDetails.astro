---
import { Icon } from "astro-icon/components";
import {
  DEFAULT_TIME_ZONE,
  isUpcoming,
  formatDate,
  formatTime,
  formatISODate,
  format24HourTime,
} from "../../../config/dateUtils.ts";
import AddToCalendarButton from "./AddToCalendarButton.astro";
import RSVP from "./RSVP.astro";
import Slides from "./Slides.astro";

const { frontmatter } = Astro.props;

const meetingDate = new Date(frontmatter.date);

const upcoming = isUpcoming(meetingDate);

const formattedDate = formatDate(meetingDate);
const formattedTime = formatTime(meetingDate);

// Variables used for the AddToCalendarButton component
const endDateObj = new Date(meetingDate.getTime() + 60 * 60 * 1000);
const startDate = formatISODate(meetingDate);
const endDate = formatISODate(endDateObj);
const startTime = format24HourTime(meetingDate);
const endTime = format24HourTime(endDateObj);

// const slidesUrl = frontmatter.slides ? withBase(frontmatter.slides) : undefined;
---

<section class="meeting-card">
  <dl>
    <div class="meeting-row">
      <dt>
        <Icon name="mdi:calendar" class="meeting-icon" />
        When
      </dt>
      <dd>
        {formattedDate}{upcoming && `, starting at ${formattedTime}`}
      </dd>
    </div>

    {
      upcoming && frontmatter.location && (
        <div class="meeting-row">
          <dt>
            <Icon name="mdi:location-on-outline" class="meeting-icon" />
            Location
          </dt>
          <dd>{frontmatter.location}</dd>
        </div>
      )
    }

    {
      frontmatter.topic && (
        <div class="meeting-row">
          <dt>
            <Icon name="mdi:text-subject" class="meeting-icon" />
            Topic
          </dt>
          <dd>{frontmatter.topic}</dd>
        </div>
      )
    }
  </dl>

  {
    upcoming && (
      <div class="meeting-actions">
        <AddToCalendarButton
          name="Build I.T. Club at UMD Meeting"
          description={frontmatter.topic ?? ""}
          location={frontmatter.location ?? ""}
          startDate={startDate}
          endDate={endDate}
          startTime={startTime}
          endTime={endTime}
          timeZone={DEFAULT_TIME_ZONE}
        />
      </div>
    )
  }
</section>

<RSVP frontmatter={frontmatter} />

<Slides frontmatter={frontmatter} />

{
  frontmatter.project && (
    <>
      <h3>Project Guide Page</h3>
      <p>
        A project guide page was created or updated based on the project completed during this meeting. See the guide{" "}
        <a href={frontmatter.project}>here</a>.
      </p>
    </>
  )
}
